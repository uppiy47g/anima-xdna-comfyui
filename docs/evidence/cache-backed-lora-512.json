      "ordinary additive 2-D LoRAAdapter",
      "hybrid Turbo Q/K norm diff",
      "any finite strength"
    ],
    "unsupported": [
      "LoHa/LoKr/OFT/DoRA/reshape/mid-weight LoRA",
